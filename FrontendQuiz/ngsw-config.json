{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/icons/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "decks",
      "urls": ["/api/quizApi/decks", "/api/quizApi/decks/**"],
      "cacheConfig": { "strategy": "freshness", "timeout": "3s", "maxSize": 100, "maxAge": "30d" }
    },
    {
      "name": "kanjivg",
      "urls": ["/kanjivg/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 3000, "maxAge": "90d" }
    }
  ]
}
