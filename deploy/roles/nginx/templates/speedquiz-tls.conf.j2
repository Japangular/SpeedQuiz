# Steady-state config. Ansible owns this fully; certbot never touches it.
# Renewals re-use /.well-known/acme-challenge/ on :80.
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name }};

    # Keep ACME path on :80 for renewals.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://{{ domain_name }}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    ssl_client_certificate /etc/nginx/ssl/speedquiz-ca.crt;
    ssl_verify_client optional;

    client_max_body_size 100m;

    location = /api/actuator/health {
        proxy_pass http://127.0.0.1:{{ backend_public_port }}/api/actuator/health;
        proxy_set_header Host $host;
    }

    location / {
        if ($ssl_client_verify != SUCCESS) {
            return 403;
        }
        proxy_pass http://127.0.0.1:{{ backend_public_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}