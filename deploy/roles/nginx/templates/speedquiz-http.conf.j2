# Bootstrap state, only used before the TLS cert exists.
# Serves :80 long enough for certbot to complete the ACME http-01 challenge.
server {
listen 80;
listen [::]:80;
server_name {{ domain_name }};

# Webroot for ACME challenge. Certbot drops files here.
location /.well-known/acme-challenge/ {
root /var/www/letsencrypt;
}

client_max_body_size 64m;

location / {
proxy_pass http://127.0.0.1:{{ backend_public_port }};
proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_read_timeout 60s;
}
}